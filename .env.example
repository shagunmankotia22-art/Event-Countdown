# Copy this file to ".env" (same folder as package.json) and fill in your values.
# Restart "npm run dev" after changing it.
#
# These two values are PUBLIC by design (they ship to the browser). Get them from your
# Supabase dashboard -> Project Settings -> API.
# NEVER put a "service_role" key, database password or any other secret here:
# anything starting with VITE_ is embedded in the website's JavaScript.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
